{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "es6"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "skipDefaultLibCheck": true,
    "typeRoots": [],
    "noResolve": false

  },
  "include": [
    "next-env.d.ts",
    "app/globals.css",
    "app/layout.tsx",
    "app/page.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/*",
    "middleware.ts",
    "app/[locale]/**/*",
    "app/api/**/*",
    "locales/**/*",
    "**/*locale*/**/*",
    "**/d3-*",
    "**/debug",
    "**/estree-jsx",
    "**/hast",
    "**/mdast",
    "**/mdx",
    "**/ms",
    "**/nodemailer",
    "**/papaparse",
    "**/unist",
    "**/use-sync-external-store"
  ]
}
